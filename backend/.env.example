# ─────────────────────────────────────────────────────────────────────────────
# CloudDeploy Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Amazon ECR Configuration ──────────────────────────────────────────────────
# The AWS region where your ECR repository lives (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1

# Your 12-digit AWS account ID (visible in the AWS console top-right corner)
AWS_ACCOUNT_ID=123456789012

# IAM user access key with ecr:GetAuthorizationToken + ecr:BatchCheckLayerAvailability
# + ecr:CompleteLayerUpload + ecr:InitiateLayerUpload + ecr:PutImage permissions
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# IAM user secret access key (keep this secret!)
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# The ECR repository name (NOT the full URI — just the name, e.g. "my-app-repo")
# The full registry URI is auto-constructed as:
#   {AWS_ACCOUNT_ID}.dkr.ecr.{AWS_REGION}.amazonaws.com/{ECR_REPOSITORY}
ECR_REPOSITORY=my-app-repo

# ─────────────────────────────────────────────────────────────────────────────
# EC2 Deployments (image pulled from ECR → containers on a fresh EC2 instance)
# ─────────────────────────────────────────────────────────────────────────────

# VPC + public subnet where deployment instances launch (must auto-assign
# public IPs — default VPC public subnets do)
EC2_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
EC2_SUBNET_ID=subnet-xxxxxxxxxxxxxxx

# Instance type for deployments (t3.micro is free-tier eligible).
# Can also be overridden per deployment in the UI.
EC2_INSTANCE_TYPE=t3.micro

# Optional: EC2 key pair name (leave empty — instances are managed without SSH)
EC2_KEY_NAME=

# Optional: pin a specific AMI (leave empty → latest Amazon Linux 2023 via SSM)
EC2_AMI_ID=
